generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  code      String   @unique
  tickets   Ticket[]
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String
  // Lowercase storage provides a portable case-insensitive unique email index without requiring citext.
  emailNormalized    String    @unique
  passwordHash       String
  role               UserRole  @default(REQUESTER)
  department         String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tickets            Ticket[]  @relation("RequesterTickets")
  ownedTickets       Ticket[]  @relation("TicketOwners")
  sessions           Session[]

  @@index([role])
  @@map("requester_user")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  tickets   Ticket[]
  createdAt DateTime @default(now())
}

model Ticket {
  id               Int             @id @default(autoincrement())
  ticketNumber     String          @unique
  summary          String
  description      String
  requestedPriority String
  status           String          @default("New")
  requesterId      Int
  categoryId       Int
  relatedSystemId  Int
  requester        User            @relation("RequesterTickets", fields: [requesterId], references: [id])
  ownerId          Int?
  owner            User?           @relation("TicketOwners", fields: [ownerId], references: [id])
  category         Category        @relation(fields: [categoryId], references: [id])
  relatedSystem    RelatedSystem   @relation(fields: [relatedSystemId], references: [id])
  attachments      Attachment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([requesterId, createdAt(sort: Desc)])
}

model Attachment {
  id            Int      @id @default(autoincrement())
  ticketId      Int
  fileName      String
  fileSize      Int
  fileType      String
  filePath      String
  isRemoved     Boolean  @default(false)
  removedAt     DateTime?
  removalReason String?  @db.VarChar(250)
  createdAt     DateTime @default(now())
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}
